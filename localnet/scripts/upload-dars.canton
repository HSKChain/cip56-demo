// Upload the CIP-56 interface DARs and the Simple Token DAR, and vet them on both synchronizers
def main(): Unit = {
  val darRoot = "/canton/host/dars"
  val dars = Seq(
    s"$darRoot/splice-api-token-metadata-v1-1.0.0.dar",
    s"$darRoot/splice-api-token-holding-v1-1.0.0.dar",
    s"$darRoot/splice-api-token-transfer-instruction-v1-1.0.0.dar",
    s"$darRoot/splice-api-token-allocation-v1-1.0.0.dar",
    s"$darRoot/splice-api-token-allocation-instruction-v1-1.0.0.dar",
    s"$darRoot/splice-api-token-allocation-request-v1-1.0.0.dar",
    s"$darRoot/simple-token-0.3.1.dar",
  )

  val pShared = participants.all
    .find(_.name.contains("shared"))
    .getOrElse(sys.error("participant-shared was not found"))

  // The package must be registered with a VettedPackages topology transaction on each synchronizer
  val syncIds = pShared.synchronizers.list_connected().map(c => c.synchronizerAlias.unwrap -> c.synchronizerId)

  dars.foreach { dar =>
    syncIds.foreach { case (alias, id) =>
      val mainPkg = pShared.dars.upload(dar, synchronizerId = Some(id))
      println(s"[dar] ${dar.split('/').last} @ $alias -> $mainPkg")
    }
  }

  println("=== parties.enable help ===")
  pShared.parties.help("enable")
  println("UPLOAD_DONE")
}

main()
